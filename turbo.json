{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#build:catalog": {
      "outputs": ["catalog.json"]
    },
    "build:catalog": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "catalog.json"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "//#build:catalog"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {},
    "verify:submodules": {
      "cache": false
    }
  }
}