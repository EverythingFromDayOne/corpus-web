# Postgres — local Docker container. Copy to `.env` and edit for your machine.
# These values MUST match what docker-compose.yml interpolates.
POSTGRES_USER=corpus
POSTGRES_PASSWORD=corpus_dev_only
POSTGRES_DB=corpus_api
# Network-level host the API process opens. The API runs on the host, so
# this is `localhost` even though the database is in a container. Docker
# publishes the container's 5432 to the host's $POSTGRES_HOST_PORT.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port on your machine that forwards to the container's 5432. Change
# if 5432 collides. The API uses POSTGRES_PORT above, not this — keep this
# in sync if you change it.
POSTGRES_HOST_PORT=5432

# API
PORT=3001
# NODE_ENV is read by Nest implicitly. Do not put it in compose — the container
# is for the database, not the API. The API runs on the host.
NODE_ENV=development
LOG_LEVEL=info

# The API assembles its own DATABASE_URL from the values above so we have one
# source of truth. If you point at an external Postgres (not recommended in
# this scaffold — see PR body), override this directly and DELETE the
# POSTGRES_* lines.
# DATABASE_URL=postgres://corpus:***@localhost:5432/corpus_api

# --- Session + CORS (D26 first slice — Google OAuth login) ----------------
# Cookie name is `corpus.sid` (not Express's default `connect.sid`) for a
# little less fingerprint surface.
SESSION_COOKIE_NAME=corpus.sid
# `false` for local HTTP, `true` for any HTTPS deployment. Local-dev default
# is `false` because `localhost` is plain HTTP. Production must be `true`.
SESSION_COOKIE_SECURE=false
# Empty by default — the cookie is pinned to the host that set it. Set to
# `.nxhhuy.tech` for apex + api. subdomain sharing in production.
SESSION_COOKIE_DOMAIN=
# Sliding session TTL in seconds. Default 30 days. Reset on every request.
SESSION_TTL_SECONDS=2592000
# Comma-separated CORS origin allowlist. Local dev: http://localhost:3000.
WEB_ORIGIN=http://localhost:3000
# Cookie signing secret. The fallback in `apps/api/src/config/session.ts` is
# deterministic for dev; production deployments MUST set this to a
# high-entropy value (32+ random base64 chars). Use the line below as a
# placeholder; replace with `openssl rand -base64 32` output.
SESSION_SECRET=[REDACTED-use-openssl-rand-base64-32]

# --- Google OAuth (D26 first slice) ---------------------------------------
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com and
# add `http://localhost:3001/auth/google/callback` to Authorized redirect
# URIs. If any of these three are missing, the API boots in auth-disabled
# mode: /healthz works, /auth/* returns 404, /me returns 401.
GOOGLE_CLIENT_ID=[REDACTED]
GOOGLE_CLIENT_SECRET=[REDACTED]
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
