# Article bodies module emitted by `scripts/build-article-bodies.mjs`
# (prebuild hook). Static TS module that bundles every adapting
# article's frontmatter-stripped markdown body so the article-render
# codepath never reads from disk at request time (D45 close, same
# shape as D43's answer-keys.ts). 4 MB for 196 articles — too large
# to track; the build script regenerates it from `catalog.json` and
# the four content submodules. Recreate locally with
# `pnpm build:catalog && node scripts/build-article-bodies.mjs`
# after a fresh clone or submodule bump.
apps/web/lib/data/article-bodies.ts
.pnpm-store/
# Pagefind index is build output emitted by `pnpm --filter @corpus/web
# build` (postbuild hook). Recreate locally with `pnpm search:index`
# after a build — never check the generated chunks into git.
apps/web/public/pagefind/
apps/web/public/pagefind.js
# Do NOT ignore content/. Submodules are gitlinks tracked by this repo;
# a content/ ignore would be inert and would read as protection while
# providing none. See scripts/verify-submodules.mjs.
# Hermes is a tool for managing environment variables in a project.
.hermes/