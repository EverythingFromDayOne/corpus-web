# Generated by `pnpm build:catalog`. article-source.ts reads paths from
# this at request time, so it must be produced during the Vercel build —
# a missing catalog is ENOENT /var/task/catalog.json in production.
catalog.json

.pnpm-store/

# Pagefind index is build output emitted by `pnpm --filter @corpus/web
# build` (postbuild hook). Recreate locally with `pnpm search:index`
# after a build — never check the generated chunks into git.
apps/web/public/pagefind/
apps/web/public/pagefind.js

# Do NOT ignore content/. Submodules are gitlinks tracked by this repo;
# a content/ ignore would be inert and would read as protection while
# providing none. See scripts/verify-submodules.mjs.

# Hermes
.hermes