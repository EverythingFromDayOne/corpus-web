.DS_Store
node_modules/
dist/
.next/
.turbo/
out/
.source/
coverage/
*.tsbuildinfo
.eslintcache
.env
.env.*
!.env.example
*.log

# Generated by `pnpm build:catalog`. article-source.ts reads paths from
# this at request time, so it must be produced during the Vercel build —
# a missing catalog is ENOENT /var/task/catalog.json in production.
catalog.json

.pnpm-store/

# Pagefind index is build output emitted by `pnpm --filter @corpus/web
# build` (postbuild hook). Recreate locally with `pnpm search:index`
# after a build — never check the generated chunks into git.
apps/web/public/pagefind/
apps/web/public/pagefind.js

# Do NOT ignore content/. Submodules are gitlinks tracked by this repo;
# a content/ ignore would be inert and would read as protection while
# providing none. See scripts/verify-submodules.mjs.

# Hermes
.hermes

# --- Phase B PM2 hosting (apps/api ecosystem + prod env) --------------------
# Each deploy/ops machine gets its own copy — the ecosystem file embeds a
# host-absolute `cwd: /home/huy/corpus-web/apps/api` that's meaningless on a
# Mac dev machine and would drift. `.env.production` is gitignored for the
# same reason as the root `.env` (secrets + host-specific DATABASE_URL).
apps/api/ecosystem.config.cjs
apps/api/.env.production
.env.production
# PM2 dump file and managed log directory. `~/.pm2/` is the convention across
# PM2 + Keymetrics; logrotate (host-level, not in repo) handles rotation.
~/.pm2/