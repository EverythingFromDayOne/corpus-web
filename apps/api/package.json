{
  "name": "@corpus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --import tsx/esm src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:generate": "echo \"Hand-write a class implementing MigrationInterface in apps/api/src/db/migrations/<ts>-<Name>.ts.\" && exit 1",
    "migration:run": "tsx src/db/migrate-run.ts",
    "migration:revert": "tsx src/db/migrate-revert.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.1.29",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/typeorm": "11.0.0",
    "connect-pg-simple": "10.0.0",
    "express-session": "1.18.2",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.20",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/express-session": "1.18.2",
    "@types/node": "^24.0.0",
    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.16",
    "@types/pg": "8.11.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "typescript": "5.9.3"
  }
}
