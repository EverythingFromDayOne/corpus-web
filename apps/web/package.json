{
  "name": "@corpus/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "node ../../scripts/build-slug-allowlist.mjs && tsx ../../scripts/build-answer-keys.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "postbuild": "pagefind --site .next/server/app --output-path public/pagefind || true",
    "search:index": "pagefind --site .next/server/app --output-path public/pagefind",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@corpus/mdx-components": "workspace:*",
    "@corpus/ui": "workspace:*",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pagefind": "1.5.2",
    "postcss": "^8.5.0",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}